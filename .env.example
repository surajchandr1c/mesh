# ==========================================
# QThorium Mesh - Environment Configuration
# ==========================================

# Redis Message Broker
REDIS_URL=redis://localhost:6379/0

# Worker Node Configuration
NODE_ID=gaming-desktop-01
NODE_API_KEY=mesh-node-secret-key-v1
GRPC_TARGET=localhost:50051

# AI Model Configuration
TARGET_MODEL=llama3.2:1b
MODEL_PATH=track1_worker_node/models/Llama-3.2-1B-Instruct-Q8_0.gguf
OLLAMA_HOST=http://localhost:11434

# Security & Authentication
JWT_SECRET_KEY=volunpc-secret-key-change-in-production-12345

# RAG & ChromaDB
CHROMA_DB_PATH=./chroma_db

# Track 4 Dashboard & Failover
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./track4_dashboard_ui/track4_dashboard_ui/node_registry.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
HEARTBEAT_INTERVAL=5.0
HEARTBEAT_TIMEOUT=10.0
NODE_OFFLINE_TIMEOUT=15.0
MAX_TASK_RETRIES=3
RETRY_BACKOFF_BASE=2.0
CPU_HEALTH_THRESHOLD=85.0
RAM_HEALTH_THRESHOLD_MB=512.0
CPU_CRITICAL_THRESHOLD=95.0
RAM_CRITICAL_THRESHOLD_MB=128.0
